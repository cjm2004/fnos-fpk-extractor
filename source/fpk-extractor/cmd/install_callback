#!/bin/bash
# ============================================================================
#  应用提取器 — 安装完成后执行
#  只做两件事：补齐脚本执行位、把服务拉起来，让桌面图标立刻可用。
#  无论成败都返回 0，不影响应用安装结果。
# ============================================================================
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
TARGET="${TRIM_APPDEST:-$(cd "$HERE/.." && pwd)/target}"

# 在 Windows 上打包会丢失执行位，这里补一次
chmod +x "$TARGET/bin/"* 2>/dev/null

/bin/bash "$HERE/main" start >/dev/null 2>&1

exit 0
