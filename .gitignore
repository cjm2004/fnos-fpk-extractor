# ---------------------------------------------------------------- 本地测试
# 假更新管理器、无头浏览器断言脚本、伪造的应用目录等，仅本地使用
/tmp/

# ---------------------------------------------------------------- 工具目录
# 本地开发用的记忆/会话数据，不属于项目产物
/.workbuddy/

# ---------------------------------------------------------------- 历史包
# 开发过程中的中间版本，从未对外发布，不入库
/history/

# ---------------------------------------------------------------- 第三方工具
# fnpack 是飞牛官方打包工具，需自行下载（见 README 第五节）
/tools/fnpack
/tools/fnpack.exe
/tools/*.zip

# ---------------------------------------------------------------- 参考文档
# 更新管理器的对接说明，非本项目产物
/fnos-update-manager.md
/fnos-update-manager.txt
/fnos-update-manager.skill

# ---------------------------------------------------------------- 构建噪声
__pycache__/
*.py[cod]
*.pyo
# fnpack 在工程目录里留下的中间产物（build.sh 会挪到仓库根目录）
/source/fpk-extractor/fpk-extractor.fpk

# ---------------------------------------------------------------- 编辑器 / 系统
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
